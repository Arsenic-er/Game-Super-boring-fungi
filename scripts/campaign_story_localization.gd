static func normalize_locale(locale: String) -> String:
	return BaseWords.normalize_locale(locale)


static func text(locale: String, key: String, values: Dictionary = {}) -> String:
	var table: Dictionary = TEXTS.get(normalize_locale(locale), TEXTS["en"])
	var template := String(table.get(key, TEXTS["en"].get(key, key)))
	return template.format(values)
